# ============================================================
# Venture AI — Environment Template
# Copy this file to `.env` and fill in real values for Docker.
# DO NOT commit `.env`.
# ============================================================

# ---------- MySQL ----------
MYSQL_DATABASE=venture_ai_db
MYSQL_USER=venture_app
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------- Backend (Spring Boot) ----------
# Internal Docker network hostname "mysql" — do NOT change unless renaming the service
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/venture_ai_db
SPRING_DATASOURCE_USERNAME=venture_app
SPRING_DATASOURCE_PASSWORD=change_me_local_password

# Generate with: openssl rand -base64 48
# Or any random 32+ byte base64 string (only [A-Za-z0-9+/=] characters)
JWT_SECRET=change_me_generate_a_random_base64_secret
JWT_EXPIRATION=86400000

# Optional — reserved for future backend → AI proxying
AI_SERVICE_URL=http://ai-service:8000

# ---------- AI Service (FastAPI) ----------
# Comma-separated list of browser origins (not container names)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---------- Frontend (build-time, baked into bundle) ----------
# These are consumed by the BROWSER, not by the container.
VITE_API_BASE_URL=http://localhost:8081/api
VITE_AI_API_BASE_URL=http://localhost:8000